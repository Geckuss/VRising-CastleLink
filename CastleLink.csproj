<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>CastleLink</AssemblyName>
    <Product>CastleLink</Product>
    <Authors>Geckuss</Authors>
    <Description>Share resources across all the castles a player owns: right-click a station recipe to pull its materials from your other castles, and use chat commands to gather/deposit resources between castles.</Description>
    <Version>1.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CastleLink</RootNamespace>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <!--
    IL2CPP interop assemblies.

    This mod targets the CURRENT V Rising build and uses recent game types
    (e.g. SharedCastleInventories) that are not yet in the public
    VRising.Unhollowed.Client NuGet package. Contributors must therefore point
    this at the interop assemblies generated by their own BepInEx install.

    Copy the DLLs from:
        <server>/BepInEx/interop/
    into a folder next to this project (default: ../server-interop/interop),
    or set the InteropDir property below / pass -p:InteropDir=... to `dotnet build`.
  -->
  <PropertyGroup>
    <InteropDir Condition="'$(InteropDir)' == ''">$(MSBuildProjectDirectory)\..\server-interop\interop</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.691" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.Core" Version="6.0.0-be.691" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="VRising.VampireCommandFramework" Version="0.10.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(InteropDir)\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
